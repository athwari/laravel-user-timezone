{
    "name": "athwari/laravel-user-timezone",
    "description": "Per-user timezone management for Laravel applications.",
    "keywords": [
        "athwari",
        "laravel",
        "timezone",
        "user-timezone",
        "carbon",
        "datetime"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/athwari/laravel-user-timezone",
    "support": {
        "issues": "https://github.com/athwari/laravel-user-timezone/issues",
        "source": "https://github.com/athwari/laravel-user-timezone"
    },
    "authors": [
        {
            "name": "Asem Athwari",
            "email": "asem@athwari.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.1",
        "orchestra/testbench": "^6.47|^7.22|^8.25|^9.10|^10.0",
        "pestphp/pest": "^1.0|^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^1.0|^2.0|^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpunit/phpunit": "^9.0|^10.0 <10.5.60|^11.0",
        "rector/rector": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Athwari\\LaravelUserTimezone\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Athwari\\LaravelUserTimezone\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Athwari\\LaravelUserTimezone\\UserTimezoneServiceProvider"
            ],
            "aliases": {
                "UserTimezone": "Athwari\\LaravelUserTimezone\\Facades\\UserTimezone"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}